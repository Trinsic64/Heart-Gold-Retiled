+// Encounter and trainer slots pack a base species into bits 0-10 and a form
+// number into bits 11-15. Their source tables use adjusted form IDs, so
+// translate those IDs before the slot is decoded into a PartyPokemon.
+u32 LONG_CALL PackFormSpecies(u32 species)
+{
+    if (species > SPECIES_MAX_MON_NUM && species <= MAX_SPECIES_INCLUDING_FORMS) {
+        u16 baseSpecies = GetBaseSpeciesFromAdjustedForm(species);
+        if (baseSpecies > SPECIES_NONE && baseSpecies <= SPECIES_MAX_MON_NUM) {
+            u16 formNo = GetFormFromAdjustedForm(species);
+            if (formNo >= 1 && formNo <= 31) {
+                return baseSpecies | (formNo << 11);
+            }
+        }
+    }
+    return species;
+}
